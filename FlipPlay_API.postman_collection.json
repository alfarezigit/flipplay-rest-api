                "exec": [
                  "pm.test('Media dibuat (201)', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('createdMediaId', body.data.id);",
                  "pm.collectionVariables.set('mediaTitle', body.data.title);"
